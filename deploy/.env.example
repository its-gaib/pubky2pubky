# Shared only by the rendezvous and official iroh relay authorization callout.
# Generate with: openssl rand -hex 32
HPK_RELAY_AUTH_SECRET=
HPK_ALLOWED_ORIGINS=https://app.example.com
HPK_RENDEZVOUS_PORT=8080
HPK_IROH_RELAY_PORT=3340
HPK_IROH_QAD_PORT=7842
# Keep both bindings on loopback when Caddy runs on this host.
HPK_RENDEZVOUS_BIND=127.0.0.1
HPK_IROH_RELAY_BIND=127.0.0.1
# QUIC address discovery must be reachable by NATed clients over UDP.
HPK_IROH_QAD_BIND=0.0.0.0
# The local Compose image uses a generated development certificate. Production
# deployments must replace it with a publicly trusted certificate and expose
# UDP 7842 (the standard iroh QAD port).
HPK_MAX_SESSIONS=10000
HPK_MAX_CONNECTIONS_PER_IDENTITY=16
HPK_MAX_CONNECTIONS=10000
HPK_MAX_REGISTRATION_NONCES=50000
