# DNS name embedded in client-facing STUN/TURN URLs.
HPK_PUBLIC_HOST=connect.example.com
# Public IPv4 address advertised in TURN relay candidates.
HPK_PUBLIC_IP=203.0.113.10
# Generate with: openssl rand -hex 32
HPK_TURN_SHARED_SECRET=
HPK_TURN_REALM=connect.example.com
HPK_ALLOWED_ORIGINS=https://app.example.com
HPK_RENDEZVOUS_PORT=8080
HPK_MAX_SESSIONS=10000
HPK_MAX_CONNECTIONS_PER_IDENTITY=16
HPK_MAX_CONNECTIONS=10000
HPK_MAX_REGISTRATION_NONCES=50000
